# Anvyl Board -- Audio Message Recorder pin constraints

# System clock (100 MHz crystal)
NET "OSC_100MHz" LOC=D11;
NET "OSC_100MHz" TNM_NET = sys_clk_pin;
TIMESPEC TS_sys_clk_pin = PERIOD sys_clk_pin 100000 kHz;

# Reset button
NET "RESET_BTN" LOC=E6;

# Push buttons (bank 3 = 2.5V VCCIO on Anvyl) - PULLUP because they're active-low
NET "BTN[0]" LOC=V5 | IOSTANDARD=LVCMOS25 | PULLUP;
NET "BTN[1]" LOC=U4 | IOSTANDARD=LVCMOS25 | PULLUP;
NET "BTN[2]" LOC=V3 | IOSTANDARD=LVCMOS25 | PULLUP;
NET "BTN[3]" LOC=P4 | IOSTANDARD=LVCMOS25 | PULLUP;

# Slide switches (bank 3, 2.5V)
NET "SW[0]" LOC=P8 | IOSTANDARD=LVCMOS25;
NET "SW[1]" LOC=P5 | IOSTANDARD=LVCMOS25;
NET "SW[2]" LOC=P6 | IOSTANDARD=LVCMOS25;
NET "SW[3]" LOC=R4 | IOSTANDARD=LVCMOS25;

# LEDs - all on bank 3 (1.8V VCCIO on Anvyl)
NET "LED[0]" LOC=W3  | IOSTANDARD=LVCMOS25;
NET "LED[1]" LOC=Y4  | IOSTANDARD=LVCMOS25;
NET "LED[2]" LOC=Y1  | IOSTANDARD=LVCMOS25;
NET "LED[3]" LOC=Y3  | IOSTANDARD=LVCMOS25;
NET "LED[4]" LOC=AB4 | IOSTANDARD=LVCMOS25;
NET "LED[5]" LOC=W1  | IOSTANDARD=LVCMOS25;
NET "LED[6]" LOC=AB3 | IOSTANDARD=LVCMOS25;
NET "LED[7]" LOC=AA4 | IOSTANDARD=LVCMOS25;

# UART
NET "rs232_tx" LOC=T20;
NET "rs232_rx" LOC=T19;

# Audio CODEC SSM2603
NET "AUD_DACDAT"  LOC=A5  | IOSTANDARD=LVCMOS33;
NET "AUD_DACLRCK" LOC=D6  | IOSTANDARD=LVCMOS33;
NET "AUD_ADCDAT"  LOC=C6  | IOSTANDARD=LVCMOS33;
NET "AUD_ADCLRCK" LOC=B6  | IOSTANDARD=LVCMOS33;
NET "AUD_MUTE"    LOC=A15 | IOSTANDARD=LVCMOS33;
NET "AUD_XCK"     LOC=A6  | IOSTANDARD=LVCMOS33;
NET "AUD_BCLK"    LOC=B12 | IOSTANDARD=LVCMOS33;
NET "AUD_I2C_SDAT" LOC=C5 | PULLUP | IOSTANDARD=LVCMOS33;
NET "AUD_I2C_SCLK" LOC=A4 | PULLUP | IOSTANDARD=LVCMOS33;

# DDR2 RAM timing config
CONFIG MCB_PERFORMANCE = STANDARD;

# DDR2 differential clock
NET "hw_ram_ck"  LOC=F2 | IOSTANDARD=DIFF_SSTL2_II;
NET "hw_ram_ckn" LOC=F1 | IOSTANDARD=DIFF_SSTL2_II;

# DDR2 control signals
NET "hw_ram_cke"  LOC=J6;
NET "hw_ram_casn" LOC=P3;
NET "hw_ram_ldm"  LOC=H1;
NET "hw_ram_odt"  LOC=M3;
NET "hw_ram_rasn" LOC=N4;
NET "hw_ram_udm"  LOC=H2;
NET "hw_ram_wen"  LOC=D2;

# DDR2 differential strobe signals
NET "hw_ram_ldqs_n" LOC=L1 | IOSTANDARD=DIFF_SSTL2_II;
NET "hw_ram_ldqs_p" LOC=L3 | IOSTANDARD=DIFF_SSTL2_II;
NET "hw_ram_udqs_n" LOC=T1 | IOSTANDARD=DIFF_SSTL2_II;
NET "hw_ram_udqs_p" LOC=T2 | IOSTANDARD=DIFF_SSTL2_II;

# DDR2 data bus
NET "hw_ram_dq[0]"  LOC=N3;
NET "hw_ram_dq[1]"  LOC=N1;
NET "hw_ram_dq[2]"  LOC=M2;
NET "hw_ram_dq[3]"  LOC=M1;
NET "hw_ram_dq[4]"  LOC=J3;
NET "hw_ram_dq[5]"  LOC=J1;
NET "hw_ram_dq[6]"  LOC=K2;
NET "hw_ram_dq[7]"  LOC=K1;
NET "hw_ram_dq[8]"  LOC=P2;
NET "hw_ram_dq[9]"  LOC=P1;
NET "hw_ram_dq[10]" LOC=R3;
NET "hw_ram_dq[11]" LOC=R1;
NET "hw_ram_dq[12]" LOC=U3;
NET "hw_ram_dq[13]" LOC=U1;
NET "hw_ram_dq[14]" LOC=V2;
NET "hw_ram_dq[15]" LOC=V1;
NET "hw_ram_dq[*]" IOSTANDARD=SSTL2_II;
NET "hw_ram_dq[*]" IN_TERM=NONE;

# DDR2 address bus
NET "hw_ram_ad[0]"  LOC=M5;
NET "hw_ram_ad[1]"  LOC=L4;
NET "hw_ram_ad[2]"  LOC=K3;
NET "hw_ram_ad[3]"  LOC=M4;
NET "hw_ram_ad[4]"  LOC=K5;
NET "hw_ram_ad[5]"  LOC=G3;
NET "hw_ram_ad[6]"  LOC=G1;
NET "hw_ram_ad[7]"  LOC=K4;
NET "hw_ram_ad[8]"  LOC=C3;
NET "hw_ram_ad[9]"  LOC=C1;
NET "hw_ram_ad[10]" LOC=K6;
NET "hw_ram_ad[11]" LOC=B1;
NET "hw_ram_ad[12]" LOC=J4;
NET "hw_ram_ad[*]" IOSTANDARD=SSTL2_II;

# DDR2 bank address
NET "hw_ram_ba[0]" LOC=E3;
NET "hw_ram_ba[1]" LOC=E1;
NET "hw_ram_ba[2]" LOC=D1;
NET "hw_ram_ba[*]" IOSTANDARD=SSTL2_II;

# Required DDR2 timing constraints (from reference project)
NET "*/memc3_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/selfrefresh_mcb_mode" TIG;
NET "*/c?_pll_lock" TIG;
INST "*/memc?_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/gen_term_calib.mcb_soft_calibration_top_inst/mcb_soft_calibration_inst/DONE_SOFTANDHARD_CAL*" TIG;
NET "*/memc?_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/gen_term_calib.mcb_soft_calibration_top_inst/mcb_soft_calibration_inst/CKE_Train" TIG;

# Allow PLL output to drive non-clock load (the audio PLL CLKIN)
PIN "cwiz/clkout_buf.O" CLOCK_DEDICATED_ROUTE = FALSE;
