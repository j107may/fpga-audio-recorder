print_str_del_hdr:
            LOAD     s0, ascii_MINUS
            CALL     send_char
            CALL     send_char
            LOAD     s0, ascii_SPACE
            CALL     send_char
            LOAD     s0, ascii_D
            CALL     send_char
            LOAD     s0, ascii_e
            CALL     send_char
            LOAD     s0, ascii_l
            CALL     send_char
            LOAD     s0, ascii_e
            CALL     send_char
            LOAD     s0, ascii_t
            CALL     send_char
            LOAD     s0, ascii_e
            CALL     send_char
            LOAD     s0, ascii_SPACE
            CALL     send_char
            LOAD     s0, ascii_MINUS
            CALL     send_char
            CALL     send_char
            CALL     print_crlf
            RETURN

print_str_delall_hdr:
            LOAD     s0, ascii_D
            CALL     send_char
            LOAD     s0, ascii_e
            CALL     send_char
            LOAD     s0, ascii_l
            CALL     send_char
            LOAD     s0, ascii_e
            CALL     send_char
            LOAD     s0, ascii_t
            CALL     send_char
            LOAD     s0, ascii_e
            CALL     send_char
            LOAD     s0, ascii_SPACE
            CALL     send_char
            LOAD     s0, ascii_A
            CALL     send_char
            LOAD     s0, ascii_l
            CALL     send_char
            LOAD     s0, ascii_l
            CALL     send_char
            LOAD     s0, ascii_QUESTION
            CALL     send_char
            CALL     print_crlf
            RETURN

print_str_confirm:
            LOAD     s0, ascii_C
            CALL     send_char
            LOAD     s0, ascii_o
            CALL     send_char
            LOAD     s0, ascii_n
            CALL     send_char
            LOAD     s0, ascii_f
            CALL     send_char
            LOAD     s0, ascii_i
            CALL     send_char
            LOAD     s0, ascii_r
            CALL     send_char
            LOAD     s0, ascii_m
            CALL     send_char
            LOAD     s0, ascii_SPACE
            CALL     send_char
            LOAD     s0, ascii_LPAREN
            CALL     send_char
            LOAD     s0, ascii_y
            CALL     send_char
            LOAD     s0, ascii_SLASH
            CALL     send_char
            LOAD     s0, ascii_n
            CALL     send_char
            LOAD     s0, ascii_RPAREN
            CALL     send_char
            LOAD     s0, ascii_COLON
            CALL     send_char
            LOAD     s0, ascii_SPACE
            CALL     send_char
            RETURN

print_str_playing:
            LOAD     s0, ascii_P
            CALL     send_char
            LOAD     s0, ascii_l
            CALL     send_char
            LOAD     s0, ascii_a
            CALL     send_char
            LOAD     s0, ascii_y
            CALL     send_char
            LOAD     s0, ascii_i
            CALL     send_char
            LOAD     s0, ascii_n
            CALL     send_char
            LOAD     s0, ascii_g
            CALL     send_char
            LOAD     s0, ascii_PERIOD
