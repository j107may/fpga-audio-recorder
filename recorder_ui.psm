;================================================================
; Subroutines: UART I/O
;================================================================

; read_char: block until a character is received, return in s1
read_char:
            INPUT    s0, port_data_pres
            TEST     s0, 01
            JUMP     Z, read_char
            INPUT    s1, port_rx
            RETURN

; send_char: send byte in s0, wait if TX buffer full
send_char:
            INPUT    sF, port_buf_full
            TEST     sF, 01
            JUMP     NZ, send_char
            OUTPUT   s0, port_tx
            RETURN
